{
  "expo": {
    "name": "Mis Gastos",
    "slug": "mis-gastos",
    "scheme": "misgastos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tonicolomina.misgastos"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sharing",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite acceder a tus fotos para adjuntar el ticket.",
          "cameraPermission": "Permite usar la cámara para fotografiar el ticket."
        }
      ]
    ]
  }
}
